CADDY_SITE_ADDRESS=https://ctf.example.org
CADDY_STORAGE_ADDRESS=https://files.ctf.example.org

# These values are embedded in a PostgreSQL URI; keep custom names URL-safe and
# generate the password from a URL-safe alphabet.
# Example: openssl rand -hex 32
POSTGRES_DB=ctfzone
POSTGRES_USER=ctfzone
POSTGRES_PASSWORD=replace-me

SECRET_KEY=replace-with-a-long-random-value
BACKEND_SERVICE_TOKEN=replace-with-an-independent-random-service-token
API_SIGNING_KEY=replace-with-an-independent-random-api-signing-key
SSH_GATEWAY_SERVICE_TOKEN=replace-with-an-independent-random-ssh-gateway-token
SETUP_TOKEN=replace-with-a-long-random-setup-token
BROWSER_SESSION_COOKIE_NAME=ctfzone_browser_session
BROWSER_SESSION_COOKIE_SECURE=true
BROWSER_SESSION_LIFETIME_SECONDS=604800
EMAIL_VERIFICATION_TTL_SECONDS=1800
BACKEND_WORKERS=2
BACKEND_THREADS=4
BACKEND_WORKER_TIMEOUT_SECONDS=75
BACKEND_API_TIMEOUT_SECONDS=5
BACKEND_EMAIL_API_TIMEOUT_SECONDS=20
BACKEND_STORAGE_API_TIMEOUT_SECONDS=60
BACKEND_TRANSITION_API_TIMEOUT_SECONDS=65
MAX_PROXY_BODY_BYTES=6291456
API_DATABASE_MAX_CONNECTIONS=10
RUST_LOG=ctfzone_api=info,tower_http=info
OBJECT_STORAGE_ACCESS_KEY=replace-with-a-random-storage-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-a-long-random-storage-secret
OBJECT_STORAGE_BUCKET=ctfzone
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_MAX_UPLOAD_BYTES=536870912
OBJECT_STORAGE_MAX_PENDING_OBJECTS_PER_PRINCIPAL=8
OBJECT_STORAGE_MAX_PENDING_BYTES_PER_PRINCIPAL=1073741824
OBJECT_STORAGE_MAX_RETAINED_BYTES_PER_PRINCIPAL=10737418240
OBJECT_STORAGE_MAX_UPLOADS_PER_HOUR_PER_PRINCIPAL=60
OBJECT_STORAGE_MAX_UPLOAD_DURATION_SECONDS=900
OBJECT_STORAGE_UPLOAD_CONCURRENCY=16
OBJECT_STORAGE_CONCURRENT_UPLOAD_MB=2048
PRESIGNED_URL_TTL_SECONDS=900
OBJECT_MAINTENANCE_INTERVAL_SECONDS=30
OBJECT_MAINTENANCE_MAX_ATTEMPTS=8
OBJECT_MAINTENANCE_STALE_CLAIM_SECONDS=300

# Private challenge instance controller. Use mock only for local development;
# production dispatches typed requests to the restricted remote helper over SSH.
CONTROLLER_REMOTE_DRIVER=ssh
REMOTE_OPERATION_TIMEOUT_SECONDS=60
RECONCILIATION_INTERVAL_SECONDS=300
STALE_CLAIM_AFTER_SECONDS=300
MAX_COMMAND_ATTEMPTS=8

# Browser SSH is limited to explicitly allowed destination networks and ports.
# Public IPv4/IPv6 destinations are allowed here; the gateway still rejects
# loopback, link-local, multicast, metadata, Docker, and control-plane ranges.
# Narrow this to the operator networks that contain your SSH hosts when known.
SSH_ALLOWED_CIDRS=0.0.0.0/0,::/0
SSH_ALLOWED_PORTS=22
SSH_IDLE_TIMEOUT_SECONDS=600
SSH_MAX_SESSION_SECONDS=1800
