SITE_ADDRESS=localhost
PUBLIC_BASE_URL=https://ctf.example.org
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_DB=ctfzone
POSTGRES_USER=ctfzone
POSTGRES_PASSWORD=replace-me

SECRET_KEY=replace-with-a-long-random-value
SETUP_TOKEN=replace-with-a-long-random-setup-token
SESSION_COOKIE_NAME=session
SESSION_LIFETIME_SECONDS=604800
BACKEND_WORKERS=2
BACKEND_THREADS=4
BACKEND_API_TIMEOUT_SECONDS=5
MAX_PROXY_BODY_BYTES=16777216
API_DATABASE_MAX_CONNECTIONS=10
RUST_LOG=ctfzone_api=info,tower_http=info
CONTROLLER_REMOTE_DRIVER=ssh
REMOTE_OPERATION_TIMEOUT_SECONDS=60
RECONCILIATION_INTERVAL_SECONDS=300
STALE_CLAIM_AFTER_SECONDS=300
MAX_COMMAND_ATTEMPTS=8
