# The helper is intended to run as a dedicated, rootless account.
CTFZONE_CONTAINER_ENGINE=podman
# Prefix for a distinct bridge per instance; keep it at most 30 characters.
CTFZONE_NETWORK=ctfzone-challenges
CTFZONE_PUBLISH_IP=0.0.0.0
CTFZONE_PUBLIC_HOSTNAME=challenges.example.org
CTFZONE_STATE_DIRECTORY=/var/lib/ctfzone-runtime
CTFZONE_SYSTEMD_SCOPE=user
CTFZONE_READ_ONLY=true
